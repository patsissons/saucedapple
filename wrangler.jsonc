{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saucedapple",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    // Exposes the static assets to the worker (env.ASSETS) so the root
    // handler can serve index.html with rewritten OpenGraph tags.
    "binding": "ASSETS",
    // Serve index.html for any non-asset path so /?url=... permalinks work.
    "not_found_handling": "single-page-application",
    // /api/* is the API; "/" goes through the worker so ?url= permalinks
    // get article-specific OpenGraph tags. Everything else is static.
    "run_worker_first": ["/api/*", "/"],
  },
  "observability": {
    "enabled": true,
  },
  // workers.dev preview URL stays enabled as a pre-DNS smoke-test target.
  "workers_dev": true,
  "routes": [
    { "pattern": "saucedapple.com", "custom_domain": true },
    { "pattern": "www.saucedapple.com", "custom_domain": true },
  ],
  "env": {
    // Hermetic e2e: point upstream origins at the local mock server.
    "e2e": {
      // Never inherit the production custom domains.
      "routes": [],
      "vars": {
        "APPLE_NEWS_ORIGIN": "http://127.0.0.1:8799/apple-news",
        "WAYBACK_API_ORIGIN": "http://127.0.0.1:8799/wayback",
        "WEB_ARCHIVE_ORIGIN": "http://127.0.0.1:8799/snapshots",
      },
    },
  },
}
